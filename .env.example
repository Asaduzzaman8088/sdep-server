PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string and database name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sdep

# BetterAuth lives in the Next.js client and exposes the JWKS endpoint
# Local dev: http://localhost:3000  |  Production (Vercel): https://sdep-client.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed browser origins (CORS)
# Local dev: http://localhost:3000
# Production: http://localhost:3000,https://sdep-client.vercel.app
CLIENT_URL=http://localhost:3000
